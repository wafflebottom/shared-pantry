generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ListTile {
  id        Int        @id @default(autoincrement())
  store     String     @map("title")
  items     ListItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ListItem {
  id         Int      @id @default(autoincrement())
  title      String
  brand      String?
  unit       String?
  qty        Float    @default(1)
  listTileID Int
  listTile   ListTile @relation(fields: [listTileID], references: [id], onDelete: Cascade)
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StorePrice {
  id        Int      @id @default(autoincrement())
  store     String
  itemKey   String
  price     Float
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([store, itemKey])
}